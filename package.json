{
  "name": "ranker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project unit",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --project int",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "seed:images": "cross-env NODE_OPTIONS=--no-deprecation SEED_WITH_IMAGES=true payload run src/seed/index.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "7.0.3",
    "graphql": "16.14.2",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
