# --- Database ---------------------------------------------------------------
# Một URL duy nhất cho runtime, migration và seed.
# Dev: Postgres trong docker-compose (pnpm db:up). Prod: Postgres của Supabase qua mạng Docker nội bộ.
DATABASE_URL=postgres://ranker:ranker@127.0.0.1:5433/ranker
# Database cho test integration (pnpm test:int). Mọi dữ liệu trong DB này bị xóa khi chạy test.
DATABASE_URL_TEST=postgres://ranker:ranker@127.0.0.1:5433/ranker_test
# Số kết nối tối đa của pool trong app (server Node chạy lâu dài, pool nhỏ cố định).
DATABASE_POOL_MAX=5

# --- Payload ----------------------------------------------------------------
# Chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
PAYLOAD_SECRET=
# URL gốc của site, không có dấu / ở cuối.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Postgres local (docker-compose) ----------------------------------------
# Major version phải khớp với Supabase trên VPS.
POSTGRES_VERSION=15
POSTGRES_PORT=5433

# --- Tài khoản mẫu cho môi trường dev (seed và test tay) -----------------------
SEED_ADMIN_EMAIL=admin@ranker.local
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=bientap@ranker.local
SEED_EDITOR_PASSWORD=

# --- Cloudflare R2 (ảnh và media) ------------------------------------------
# Mỗi môi trường một bucket riêng (dev / staging / production).
# Endpoint S3 của tài khoản: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
# API token R2 quyền "Object Read & Write", giới hạn trong đúng bucket trên.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# URL công khai của bucket, không có / ở cuối (r2.dev hoặc custom domain, ví dụ https://media.ranker.vn).
R2_PUBLIC_URL=
# Thư mục con trong bucket cho môi trường này (ví dụ dev). Để trống ở production.
R2_PREFIX=

# --- Triển khai ---------------------------------------------------------------
# Staging: true để chặn index (robots.txt Disallow + header X-Robots-Tag). Production: để trống.
NOINDEX=
# Truy vấn chạy quá thời gian này (ms) bị hủy. Mặc định 30000.
DATABASE_STATEMENT_TIMEOUT_MS=30000
